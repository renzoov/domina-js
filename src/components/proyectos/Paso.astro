---
// Un paso de la guía de un proyecto. El título y la solución salen del app.js final
// (bloque «// PASO n»); la explicación, la comprobación y las pistas van como hijos, en el MDX.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { analizar, paso } from '../../lib/pasos-proyecto.mjs';
import CodigoPaso from './CodigoPaso.astro';

interface Props {
  n: number;
  /** Carpeta del proyecto dentro de proyectos/ */
  proyecto: string;
  /** slug del proyecto, para guardar el progreso */
  slug: string;
}
const { n, proyecto, slug } = Astro.props;
const an = analizar(readFileSync(join(process.cwd(), 'proyectos', proyecto, 'final', 'app.js'), 'utf8'));
const datos = paso(an, n);
const titulo = datos.titulo.charAt(0).toUpperCase() + datos.titulo.slice(1);
const id = `proyecto/${slug}/paso-${n}`;
const lineasCodigo = datos.codigo.split('\n').map((texto) => ({ texto }));
---
<section class="paso" id={`paso-${n}`} data-paso={id} aria-labelledby={`paso-${n}-t`}>
  <header class="cabeza">
    <span class="num" aria-hidden="true">{n}</span>
    <h3 id={`paso-${n}-t`}><span class="sr-only">Paso {n}: </span>{titulo}</h3>
    <span class="marca-hecho" data-marca-hecho hidden>Hecho</span>
  </header>

  <div class="cuerpo">
    <slot />
  </div>

  <details class="solucion">
    <summary>Ver la solución del paso {n}</summary>
    <div class="solucion-cuerpo">
      <p>En <code>app.js</code>, entre <code>// PASO {n}</code> y <code>// FIN PASO {n}</code>:</p>
      <CodigoPaso lineas={lineasCodigo} />
      {datos.cambios.map((c) => (
        <>
          <p>
            {c.donde === 'el arranque'
              ? <>Y al final del archivo, en el arranque{c.lineas.every((l) => l.nueva) ? ', escribe:' : ', agrega las líneas marcadas:'}</>
              : <>Y en <code>{c.donde}</code>, que escribiste en el paso {c.paso}, agrega las líneas marcadas:</>}
          </p>
          <CodigoPaso lineas={c.lineas} marcar={!c.lineas.every((l) => l.nueva)} copiar={false} />
        </>
      ))}
    </div>
  </details>

  <label class="hecho">
    <input type="checkbox" data-hecho-paso={id} />
    <span>Terminé este paso</span>
  </label>
</section>

<style>
  .paso {
    position: relative;
    margin: 0 0 28px;
    padding: 24px 26px 22px;
    background: var(--board-lo);
    border: 2px solid var(--chalk-08);
    border-radius: var(--r-chalk);
    scroll-margin-top: 20px;
  }
  .paso.completo { border-color: color-mix(in srgb, var(--lima) 40%, transparent); }
  .cabeza { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .num {
    flex: none;
    display: grid; place-items: center;
    width: 42px; height: 42px;
    font: 700 1.35rem/1 var(--hand); color: var(--c, var(--lima));
    border: 2px solid currentColor;
    border-radius: 48% 52% 45% 55% / 55% 45% 52% 48%;
  }
  h3 { margin: 0; font: 700 clamp(1.45rem, 2.2vw, 1.75rem) / 1.15 var(--hand); color: var(--chalk); text-wrap: balance; }
  .marca-hecho {
    margin-left: auto; flex: none;
    padding: 4px 10px;
    font: 700 0.8rem/1 var(--read); color: var(--board-lo);
    background: var(--lima); border-radius: var(--r-trazo);
  }
  .marca-hecho[hidden] { display: none; }

  .cuerpo { max-width: var(--measure); }
  .cuerpo > :global(p), .cuerpo > :global(ul > li), .cuerpo > :global(ol > li) { font-size: 1.0625rem; line-height: 1.65; color: var(--chalk); }
  .cuerpo > :global(p) { margin: 0 0 1em; }
  .cuerpo > :global(ul), .cuerpo > :global(ol) { margin: 0 0 1em; padding-left: 1.3em; }
  .cuerpo > :global(ul > li), .cuerpo > :global(ol > li) { margin: 0.3em 0; }
  .cuerpo :global(:not(pre) > code) { font: 400 0.9em var(--mono); color: var(--naranja); padding: 0 0.15em; border-bottom: 1px dashed var(--chalk-45); }
  .cuerpo :global(a) { color: var(--y); text-decoration-color: var(--y); }
  .cuerpo :global(strong) { color: var(--chalk); }
  .cuerpo > :global(pre) { font: 400 0.875rem/1.6 var(--mono); padding: 14px 18px; margin: 0 0 1.2em; background: var(--pozo-hondo) !important; border: 2px solid var(--chalk-15); border-radius: var(--r-chalk); overflow-x: auto; }

  .solucion { margin-top: 18px; border-top: 1px dashed var(--chalk-15); padding-top: 14px; }
  .solucion summary {
    width: fit-content;
    cursor: pointer;
    font: 700 1rem/1.3 var(--read); color: var(--y);
    list-style-position: inside;
  }
  .solucion summary:hover { text-decoration: underline; text-underline-offset: 3px; }
  .solucion-cuerpo { margin-top: 14px; }
  .solucion-cuerpo > p { margin: 0 0 10px; color: var(--chalk-70); line-height: 1.55; }
  .solucion-cuerpo code { font: 400 0.9em var(--mono); color: var(--naranja); }

  .hecho {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 18px;
    padding: 9px 14px 9px 10px;
    font: 700 0.95rem/1 var(--read); color: var(--chalk);
    border: 2px solid var(--chalk-15); border-radius: var(--r-chalk);
    cursor: pointer;
  }
  .hecho:hover { border-color: var(--chalk-45); }
  .hecho input { width: 20px; height: 20px; margin: 0; accent-color: var(--lima); cursor: pointer; }
  .hecho:has(input:checked) { border-color: color-mix(in srgb, var(--lima) 55%, transparent); }
  .hecho:has(input:focus-visible) { outline: 3px solid var(--y); outline-offset: 2px; }

  @media (max-width: 640px) {
    .paso { padding: 18px 16px; }
  }
</style>
