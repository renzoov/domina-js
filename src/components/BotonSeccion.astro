---
// Botón a una sección propia del sitio (Proyectos, Librerías), con la estética de Rayos X y su propio color.
// Mientras la sección no exista, `pronto` lo deja tachado, sin enlace y con el aviso «Próximamente».
// El ícono va en el slot: un SVG de 32×32 con trazos (sin relleno), que toma el color de la sección.
interface Props {
  texto: string;
  href: string;
  /** Nombre de la variable de color del sitio: lila, naranja, azul… */
  color: string;
  pronto?: boolean;
  actual?: boolean;
}
const { texto, href, color, pronto = true, actual = false } = Astro.props;
const Etiqueta = pronto ? 'span' : 'a';
const idAviso = `${href.replace(/\W+/g, '')}-pronto`;
---
<Etiqueta
  class:list={['seccion', { pronto }]}
  style={`--c-seccion: var(--${color})`}
  href={pronto ? undefined : href}
  tabindex={pronto ? 0 : undefined}
  aria-disabled={pronto ? 'true' : undefined}
  aria-current={actual ? 'page' : undefined}
  aria-describedby={pronto ? idAviso : undefined}
>
  <span class="ico" aria-hidden="true"><slot /></span>
  <span class="txt">{texto}</span>
  {pronto && <span class="aviso" id={idAviso} role="tooltip">Próximamente</span>}
</Etiqueta>

<style>
  .seccion {
    --c: var(--c-seccion);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 9px;
    color: var(--chalk);
    text-decoration: none;
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in srgb, var(--c) 16%, transparent), transparent 70%),
      #0d1814;
    border: 2px solid color-mix(in srgb, var(--c) 70%, transparent);
    border-radius: var(--r-chalk);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 10%, transparent), 0 0 14px color-mix(in srgb, var(--c) 26%, transparent), inset 0 0 10px color-mix(in srgb, var(--c) 14%, transparent);
    transform: rotate(1.5deg);
    transition: box-shadow 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .ico { flex: none; display: flex; width: 20px; height: 20px; filter: drop-shadow(0 0 3px color-mix(in srgb, var(--c) 60%, transparent)); }
  .ico :global(svg) { width: 100%; height: 100%; fill: none; stroke: var(--c); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .txt { position: relative; font: 700 1.2rem/1 var(--hand); letter-spacing: 0.01em; text-shadow: 0 0 6px color-mix(in srgb, var(--c) 50%, transparent); }

  a.seccion:hover, a.seccion:focus-visible { border-color: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent), 0 0 22px color-mix(in srgb, var(--c) 45%, transparent); }
  a.seccion[aria-current='page'] { --c: var(--y); }

  /* Todavía no existe: apagado, tachado con un trazo de tiza y sin enlace */
  .pronto { cursor: not-allowed; border-style: dashed; box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 6%, transparent); }
  .pronto .ico, .pronto .txt { opacity: 0.6; }
  .pronto .txt::after {
    content: '';
    position: absolute;
    left: -3px; right: -3px; top: 52%;
    height: 2.5px;
    border-radius: 2px;
    background: var(--pink);
    transform: rotate(-6deg);
    box-shadow: 0 0 4px rgba(242, 167, 184, 0.5);
  }

  /* El aviso: una nota de tiza que aparece debajo al pasar el mouse o con el foco */
  .aviso {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    z-index: 10;
    padding: 6px 12px;
    font: 700 1.05rem/1 var(--hand);
    color: var(--pink);
    white-space: nowrap;
    background: var(--board-lo);
    border: 2px solid color-mix(in srgb, var(--pink) 55%, transparent);
    border-radius: var(--r-chalk-2);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px) rotate(-2deg);
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out), visibility 0s linear 160ms;
    pointer-events: none;
  }
  .aviso::before {
    content: '';
    position: absolute;
    top: -7px; left: 50%;
    width: 10px; height: 10px;
    background: var(--board-lo);
    border-left: 2px solid color-mix(in srgb, var(--pink) 55%, transparent);
    border-top: 2px solid color-mix(in srgb, var(--pink) 55%, transparent);
    transform: translateX(-50%) rotate(45deg);
  }
  .pronto:hover .aviso, .pronto:focus-visible .aviso {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) rotate(-2deg);
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out), visibility 0s;
  }
  .pronto:focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .aviso { transition: none; } }
</style>
