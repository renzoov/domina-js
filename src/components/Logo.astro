---
interface Props { href?: string; compacto?: boolean }
const { href = '/', compacto = false } = Astro.props;
---
<a class="logo" href={href} aria-label="domina-js, inicio">
  <svg width="50" height="46" viewBox="0 0 50 46" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 4c-5 0-7 2-6.6 7.5.3 5-.4 8.6-4.9 11 4.6 2.6 5.3 6 4.9 11.2C7 39.7 9 42 14 42" stroke="#ECEAE2" stroke-width="3.2" opacity=".92"/>
    <path d="M36 4c5 0 7 2 6.6 7.5-.3 5 .4 8.6 4.9 11-4.6 2.6-5.3 6-4.9 11.2.4 6-1.6 8.3-6.6 8.3" stroke="#ECEAE2" stroke-width="3.2" opacity=".92"/>
    <path d="M17 31.5c5-.8 11-1 16.5-.2" stroke="#F7DF1E" stroke-width="4.2" stroke-dasharray="9 1.6 12 1.4"/>
    <path d="M19 16.5h12M20.5 22.5h9" stroke="#8FD0F7" stroke-width="2.4" opacity=".85"/>
  </svg>
  <span class="texto">
    <b>domina<span>.js</span></b>
    {!compacto && <small>JavaScript paso a paso</small>}
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--chalk); }
  .logo svg { flex: none; }
  .texto { display: flex; flex-direction: column; }
  b { font: 700 1.9rem/1 var(--hand); letter-spacing: 0.01em; text-shadow: 0 0 2px rgba(236, 234, 226, 0.4); }
  b span { color: var(--y); }
  small { font: 700 0.68rem/1 var(--read); color: var(--azul); letter-spacing: 0.12em; text-transform: uppercase; margin-top: 5px; }
  .logo:hover b span { text-shadow: 0 0 6px rgba(247, 223, 30, 0.45); }
</style>
