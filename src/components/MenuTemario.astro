---
// Menú lateral con todo el temario: secciones desplegables y sus temas.
import { getCollection } from 'astro:content';
import Icono from './Icono.astro';
import { temario, totalTemas } from '../data/temario';

interface Props {
  /** Tema que se está viendo, para marcarlo */
  actual?: { seccion: string; tema: string };
  /** Apartados de la lección actual */
  indice?: { slug: string; texto: string }[];
}
const { actual, indice = [] } = Astro.props;
const lecciones = await getCollection('lecciones');
const disponibles = new Set(lecciones.map((l) => `${l.data.seccion}/${l.data.tema}`));
const ejerciciosPorTema = Object.fromEntries(lecciones.map((l) => [`${l.data.seccion}/${l.data.tema}`, l.data.ejercicios]));
const publicados = disponibles.size;
---
<div class="menu" data-menu>
  <button type="button" class="abrir btn" aria-expanded="false" aria-controls="menu-temario" data-abrir>
    <span class="rayas" aria-hidden="true"><i></i><i></i><i></i></span>
    Secciones y temas
  </button>

  <nav id="menu-temario" class="panel" aria-label="Temario completo" data-panel>
    <div class="cab">
      <p class="titulo">Temario</p>
      <p class="cuenta">{publicados} de {totalTemas} temas publicados</p>
      <p class="progreso" data-progreso hidden></p>
    </div>
    <ol class="secciones">
      {temario.map((s) => {
        const hay = s.temas.filter((t) => disponibles.has(`${s.slug}/${t.slug}`)).length;
        const abierta = hay > 0 || actual?.seccion === s.slug;
        return (
          <li>
            <details open={abierta}>
              <summary>
                <span class="num" aria-hidden="true">{s.numero}</span>
                <span class="nombre"><span class="sr-only">Sección {s.numero}: </span>{s.titulo}</span>
                <span class="cuantos" aria-label={`${hay} de ${s.temas.length} temas publicados`}>{hay}/{s.temas.length}</span>
                <span class="flecha" aria-hidden="true"><Icono nombre="bajar" /></span>
              </summary>
              <ol class="temas">
                {s.temas.map((t) => {
                  const clave = `${s.slug}/${t.slug}`;
                  const hay = disponibles.has(clave);
                  const esta = actual?.seccion === s.slug && actual?.tema === t.slug;
                  return (
                    <li class:list={{ hay, esta }}>
                      {hay ? (
                        <a href={`/${clave}`} aria-current={esta ? 'page' : undefined} data-tema={clave} data-ejercicios={(ejerciciosPorTema[clave] ?? []).join(',')}>
                          <span class="txt">{t.titulo}</span>
                          <span class="hecho" data-hecho hidden><Icono nombre="ok" titulo="Ejercicios resueltos" /></span>
                        </a>
                      ) : (
                        <span class="txt">{t.titulo}<span class="sr-only"> (próximamente)</span></span>
                      )}
                      {esta && indice.length > 0 && (
                        <ol class="apartados" aria-label="En esta lección">
                          {indice.map((h) => <li><a href={`#${h.slug}`}>{h.texto}</a></li>)}
                        </ol>
                      )}
                    </li>
                  );
                })}
              </ol>
            </details>
          </li>
        );
      })}
    </ol>
    <a class="todo" href="/temario">Ver el temario con detalle<Icono nombre="der" /></a>
  </nav>
</div>

<script>
  import { resumen } from '../scripts/progreso';

  function pintarProgreso() {
    const datos = resumen();
    let hechos = 0;
    let total = 0;
    document.querySelectorAll<HTMLAnchorElement>('[data-menu] a[data-tema]').forEach((a) => {
      const ids = (a.dataset.ejercicios || '').split(',').filter(Boolean);
      const resueltos = ids.filter((id) => datos.ejercicios[id]).length;
      total += ids.length;
      hechos += resueltos;
      const marca = a.querySelector<HTMLElement>('[data-hecho]');
      if (marca) marca.hidden = !(ids.length && resueltos === ids.length);
    });
    const p = document.querySelector<HTMLElement>('[data-menu] [data-progreso]');
    if (p && hechos) {
      p.hidden = false;
      p.textContent = `Llevas ${hechos} de ${total} ejercicios resueltos`;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
    const boton = menu.querySelector<HTMLButtonElement>('[data-abrir]')!;
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.classList.toggle('abierto', !abierto);
    });
  });
  pintarProgreso();
  document.addEventListener('domina:progreso', pintarProgreso);

  // Al abrir una lección, la barra lateral se desplaza hasta el tema actual
  const temaActual = document.querySelector<HTMLElement>('[data-menu] a[aria-current="page"]');
  const barra = temaActual?.closest<HTMLElement>('.lado-fijo');
  if (temaActual && barra && barra.scrollHeight > barra.clientHeight) {
    const delta = temaActual.getBoundingClientRect().top - barra.getBoundingClientRect().top;
    barra.scrollTop += delta - barra.clientHeight / 3;
  }

  // Resalta en el menú el apartado de la lección que se está leyendo
  const apartados = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-menu] .apartados a'));
  const destinos = apartados.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  let pendiente = false;
  function marcarLectura() {
    pendiente = false;
    let actual = -1;
    destinos.forEach((d, i) => {
      if (d && d.getBoundingClientRect().top < window.innerHeight * 0.3) actual = i;
    });
    apartados.forEach((a, i) => a.classList.toggle('leyendo', i === actual));
  }
  if (apartados.length) {
    window.addEventListener('scroll', () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(marcarLectura); }
    }, { passive: true });
    marcarLectura();
  }
</script>

<style>
  .menu { min-width: 0; }
  .abrir { display: none; }

  .panel { padding: 0 0 8px; }
  .cab { padding: 0 0 14px; margin-bottom: 8px; border-bottom: 2px dashed var(--chalk-15); }
  .titulo { margin: 0; font: 700 1.7rem/1 var(--hand); color: var(--chalk); }
  .cuenta, .progreso { margin: 6px 0 0; font-size: 0.85rem; line-height: 1.4; color: var(--chalk-70); }
  .progreso { color: var(--ok); font-weight: 700; }

  .secciones, .temas { list-style: none; margin: 0; padding: 0; }
  details { border-bottom: 1px dashed var(--chalk-15); }
  summary {
    display: grid;
    grid-template-columns: 28px 1fr auto 18px;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
    color: var(--chalk);
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .nombre { text-decoration: underline; text-decoration-color: var(--chalk-45); }
  .num {
    display: grid; place-items: center;
    width: 26px; height: 26px;
    font: 700 0.95rem/1 var(--hand);
    border: 2px solid var(--chalk-45);
    border-radius: 48% 52% 45% 55% / 55% 45% 52% 48%;
  }
  .cuantos { font: 400 0.75rem var(--mono); color: var(--chalk-70); }
  .flecha { display: grid; place-items: center; color: var(--chalk-70); transition: transform 200ms var(--ease-out); }
  .flecha :global(svg) { width: 16px; height: 16px; }
  details[open] .flecha { transform: rotate(180deg); }

  .temas { padding: 0 0 12px 36px; display: grid; gap: 2px; }
  .temas li { font-size: 0.9rem; line-height: 1.35; }
  .temas .txt { color: var(--chalk-70); }
  .temas a { display: flex; align-items: center; gap: 6px; padding: 4px 0; color: var(--chalk); text-decoration: none; }
  .temas a .txt { color: var(--chalk); font-weight: 700; background: linear-gradient(transparent 82%, var(--chalk-45) 82% 92%, transparent 92%); }
  .temas a:hover .txt { background: linear-gradient(transparent 82%, var(--chalk-70) 82% 92%, transparent 92%); }
  .temas a[aria-current='page'] .txt { background: linear-gradient(transparent 82%, var(--y-90) 82% 94%, transparent 94%); }
  .temas li:not(.hay) { padding: 4px 0; }
  .hecho { display: inline-grid; color: var(--ok); }
  .esta { position: relative; }
  .esta::before { content: ''; position: absolute; left: -14px; top: 6px; height: 1.2em; width: 3px; background: var(--y); border-radius: var(--r-trazo); }
  .apartados { list-style: none; margin: 4px 0 6px; padding: 0 0 0 12px; border-left: 2px solid var(--chalk-15); display: grid; gap: 2px; }
  .apartados a { display: block; padding: 3px 0; font-size: 0.92rem; line-height: 1.35; color: var(--chalk-70); text-decoration: none; }
  .apartados a:hover { color: var(--chalk); }
  .apartados :global(a.leyendo) { color: var(--chalk); font-weight: 700; position: relative; }
  .apartados :global(a.leyendo)::before { content: ''; position: absolute; left: -16px; top: 0.55em; width: 8px; height: 8px; border-radius: 50%; background: var(--azul); }
  .hecho :global(svg) { width: 15px; height: 15px; }

  .todo { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-weight: 700; font-size: 0.9rem; color: var(--chalk-70); text-decoration: none; }
  .todo:hover { color: var(--chalk); }
  .todo :global(svg) { width: 16px; height: 16px; }

  /* Teléfono y tableta: el menú se abre con un botón */
  @media (max-width: 960px) {
    .abrir { display: inline-flex; }
    .panel { display: none; padding: 16px 0 0; }
    .menu.abierto .panel { display: block; }
  }
  .rayas { display: grid; gap: 3px; width: 16px; }
  .rayas i { display: block; height: 2px; background: currentColor; border-radius: var(--r-trazo); }
  .rayas i:nth-child(2) { width: 75%; }
</style>
