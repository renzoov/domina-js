---
// Botón a Rayos X, con su propia estética de «radiografía»: azul que brilla, letra de tiza y un barrido de luz.
// 'nav' va en la navegación principal; 'grande', en la portada y al final de cada Reto del motor.
interface Props {
  variante?: 'nav' | 'grande';
  texto?: string;
  actual?: boolean;
}
const { variante = 'grande', texto = 'Rayos X', actual = false } = Astro.props;
---
<a class:list={['rayosx', variante]} href="/rayos-x" aria-current={actual ? 'page' : undefined}>
  <svg class="ico" viewBox="0 0 32 32" aria-hidden="true">
    <!-- Una costilla de radiografía dentro de un marco de visor -->
    <path d="M5 10V6.5A1.5 1.5 0 0 1 6.5 5H10M22 5h3.5A1.5 1.5 0 0 1 27 6.5V10M27 22v3.5a1.5 1.5 0 0 1-1.5 1.5H22M10 27H6.5A1.5 1.5 0 0 1 5 25.5V22" />
    <path d="M16 9v14M16 12c-3-1.6-5.5-1-7 1M16 12c3-1.6 5.5-1 7 1M16 16c-3-1.6-5.5-1-7 1M16 16c3-1.6 5.5-1 7 1M16 20c-2.5-1.3-4.5-.8-5.8.7M16 20c2.5-1.3 4.5-.8 5.8.7" />
  </svg>
  <span class="txt">{texto}</span>
</a>

<style>
  .rayosx {
    --rx: var(--azul);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    color: var(--chalk);
    text-decoration: none;
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in srgb, var(--rx) 16%, transparent), transparent 70%),
      #0d1814;
    border: 2px solid color-mix(in srgb, var(--rx) 70%, transparent);
    border-radius: var(--r-chalk);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rx) 10%, transparent), 0 0 14px color-mix(in srgb, var(--rx) 28%, transparent), inset 0 0 10px color-mix(in srgb, var(--rx) 14%, transparent);
    transition: box-shadow 200ms var(--ease-out), transform 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  /* Barrido de luz, como un escáner, al pasar el mouse */
  .rayosx::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, color-mix(in srgb, var(--rx) 35%, transparent) 50%, transparent 70%);
    transform: translateX(-120%);
    pointer-events: none;
  }
  .rayosx:hover, .rayosx:focus-visible {
    border-color: var(--rx);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rx) 18%, transparent), 0 0 22px color-mix(in srgb, var(--rx) 45%, transparent), inset 0 0 12px color-mix(in srgb, var(--rx) 20%, transparent);
  }
  .rayosx:hover::after { animation: barrido 900ms var(--ease-out); }
  @keyframes barrido { to { transform: translateX(120%); } }
  @media (prefers-reduced-motion: reduce) { .rayosx:hover::after { animation: none; } }

  .ico { flex: none; fill: none; stroke: var(--rx); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 3px color-mix(in srgb, var(--rx) 60%, transparent)); }
  .txt { font-family: var(--hand); font-weight: 700; line-height: 1; letter-spacing: 0.01em; text-shadow: 0 0 6px color-mix(in srgb, var(--rx) 55%, transparent); }

  .nav { padding: 5px 12px 5px 9px; transform: rotate(-1.5deg); }
  .nav .ico { width: 20px; height: 20px; }
  .nav .txt { font-size: 1.2rem; }
  .nav[aria-current='page'] { border-color: var(--y); --rx: var(--y); }

  .grande { padding: 14px 26px 14px 20px; gap: 12px; max-width: 100%; }
  .grande .ico { width: 34px; height: 34px; }
  .grande .txt { font-size: clamp(1.5rem, 5vw, 1.9rem); white-space: nowrap; }
  .rayosx:active { transform: translateY(1px); }
  .nav:active { transform: rotate(-1.5deg) translateY(1px); }
</style>
