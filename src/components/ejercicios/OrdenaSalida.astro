---
import Ejercicio from './Ejercicio.astro';
import Icono from '../Icono.astro';
import { resaltar } from '../../lib/resaltar';

interface Props {
  id: string;
  numero: number;
  titulo: string;
  codigo: string;
  /** Salida correcta, en orden */
  salida: string[];
  /** Orden inicial en que se muestran las tarjetas (índices de `salida`) */
  inicio: number[];
  explicacion: string;
}
const { id, numero, titulo, codigo, salida, inicio, explicacion } = Astro.props;
const lineas = resaltar(codigo);
---
<Ejercicio id={id} numero={numero} formato="Ordena la salida" titulo={titulo}>
  <slot name="enunciado" slot="enunciado" />
  <div class="ordena" data-ordena data-id={id}>
    <pre class="codigo caja"><code>{lineas.map((html, i) => (<span class="l"><i aria-hidden="true">{i + 1}</i><Fragment set:html={html || ' '} /></span>))}</code></pre>
    <div class="lado">
      <p class="rotulo">Consola, de arriba abajo</p>
      <ol class="tarjetas" data-lista aria-label="Líneas de la consola. Usa los botones para moverlas.">
        {inicio.map((k) => (
          <li class="tarjeta caja" draggable="true" data-k={k}>
            <span class="txt">{salida[k]}</span>
            <span class="mover">
              <button type="button" class="mini" data-subir aria-label={`Subir «${salida[k]}»`}><Icono nombre="subir" /></button>
              <button type="button" class="mini" data-bajar aria-label={`Bajar «${salida[k]}»`}><Icono nombre="bajar" /></button>
            </span>
          </li>
        ))}
      </ol>
      <button type="button" class="btn btn--y comprobar" data-comprobar>Comprobar el orden</button>
      <p class="feedback" data-feedback aria-live="polite"></p>
      <p class="explica" data-explica hidden set:html={explicacion} />
    </div>
  </div>
</Ejercicio>

<script>
  import { iniciarOrdenar } from '../../scripts/ejercicios';
  iniciarOrdenar();
</script>

<style>
  .ordena { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 300px); gap: 20px; align-items: start; }
  .codigo { margin: 0; padding: 10px 0; font: 400 0.82rem/1.5rem var(--mono); background: var(--pozo); overflow-x: auto; }
  .codigo code { display: block; min-width: max-content; }
  .l { display: block; white-space: pre; padding-right: 12px; }
  .l i { display: inline-block; width: 34px; padding-right: 12px; text-align: right; font-style: normal; color: var(--azul); opacity: 0.75; }
  .lado { display: flex; flex-direction: column; gap: 10px; }
  .tarjetas { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tarjeta { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 12px; font: 600 0.9rem var(--mono); cursor: grab; background: var(--pozo); transition: border-color 160ms var(--ease-out); }
  .tarjeta.arrastrando { opacity: 0.5; }
  .tarjeta.bien { border-color: var(--ok); }
  .tarjeta.mal { border-color: var(--red); }
  .txt { flex: 1; }
  .mover { display: flex; gap: 2px; }
  .mini { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; background: none; border: 0; color: var(--chalk-70); cursor: pointer; border-radius: var(--r-suave); }
  .mini:hover { color: var(--chalk); background: var(--chalk-08); }
  .mini :global(svg) { width: 18px; height: 18px; }
  .comprobar { align-self: flex-start; }
  .feedback { margin: 0; min-height: 1.5em; font-size: 0.92rem; color: var(--chalk-70); }
  .feedback :global(.no) { color: var(--red); font-weight: 700; }
  .feedback :global(.ok) { color: var(--ok); font-weight: 700; }
  .explica { margin: 0; font-size: 0.92rem; color: var(--chalk-70); line-height: 1.55; }
  .explica :global(code) { font-family: var(--mono); color: var(--chalk); }
  @container (max-width: 620px) { .ordena { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .ordena { grid-template-columns: 1fr; } }
</style>
