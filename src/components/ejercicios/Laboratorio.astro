---
import Ejercicio from './Ejercicio.astro';
import Icono from '../Icono.astro';
import { resaltar } from '../../lib/resaltar';

interface Verificacion { texto: string; prueba: string }
interface Props {
  id: string;
  numero: number;
  titulo: string;
  inicial: string;
  verificaciones: Verificacion[];
  pistas: [string, string, string];
  solucion: string;
  explicacion: string;
}
const { id, numero, titulo, inicial, verificaciones, pistas, solucion, explicacion } = Astro.props;
const solucionHtml = resaltar(solucion);
---
<Ejercicio id={id} numero={numero} formato="Laboratorio" titulo={titulo}>
  <slot name="enunciado" slot="enunciado" />
  <div class="lab" data-lab data-id={id}>
    <div class="marco">
      <div class="cv-barra">
        <span class="cv-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="cv-nombre">programa.js</span>
        <span class="vivo">se ejecuta mientras escribes</span>
      </div>
      <div class="editor" data-editor>
        <label class="sr-only" for={`${id}-texto`}>Tu código</label>
        <textarea id={`${id}-texto`} data-respaldo spellcheck="false">{inicial}</textarea>
      </div>
      <div class="salida">
        <p class="cv-prompt">$ node programa.js</p>
        <output data-salida>(escribe tu código: se ejecuta solo)</output>
      </div>
    </div>
    <div class="lado">
      <p class="rotulo">Lo que debe cumplir</p>
      <ul class="checks" data-checks aria-live="polite">
        {verificaciones.map((v) => (
          <li data-estado="pendiente"><span class="marca" aria-hidden="true"></span><span set:html={v.texto} /><span class="sr-only" data-sr> (pendiente)</span></li>
        ))}
      </ul>
      <div class="botones">
        <button type="button" class="btn" data-pista><Icono nombre="pista" /><span>Pedir una pista</span> <small data-pista-n>(1 de 3)</small></button>
        <button type="button" class="btn btn--quiet" data-ver-solucion disabled><Icono nombre="ojo" />Ver la solución</button>
        <button type="button" class="btn btn--quiet" data-restaurar><Icono nombre="reiniciar" />Restaurar</button>
      </div>
      <ol class="pistas" data-pistas aria-live="polite"></ol>
    </div>
    <div class="solucion" data-solucion hidden>
      <p class="rotulo">Una solución</p>
      <pre class="caja"><code>{solucionHtml.map((h, i) => (<span class="l"><i aria-hidden="true">{i + 1}</i><Fragment set:html={h || ' '} /></span>))}</code></pre>
      <div class="explica" set:html={explicacion} />
    </div>
    <script type="application/json" data-config set:html={JSON.stringify({ inicial, verificaciones: verificaciones.map((v) => v.prueba), pistas }).replace(/</g, '\\u003c')} />
  </div>
</Ejercicio>

<script>
  // El editor pesa: se carga cuando el laboratorio se acerca a la pantalla.
  const labs = document.querySelectorAll('[data-lab]');
  const cargar = () => import('../../scripts/laboratorio').then((m) => m.iniciarLaboratorios());
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      if (entradas.some((e) => e.isIntersecting)) {
        io.disconnect();
        cargar();
      }
    }, { rootMargin: '600px 0px' });
    labs.forEach((l) => io.observe(l));
  } else cargar();
</script>

<style>
  .lab { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-items: start; }
  .lado { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .marco { border: 2px solid color-mix(in srgb, var(--lila) 45%, transparent); border-radius: var(--r-chalk); background: var(--board-lo); overflow: hidden; min-width: 0; box-shadow: 0 0 0 4px color-mix(in srgb, var(--lila) 8%, transparent); }
  .vivo { margin-left: auto; font: 400 0.75rem var(--read); color: var(--lila); }
  .editor { min-height: 240px; background: rgba(0, 0, 0, 0.12); overflow: hidden; }
  .editor textarea {
    width: 100%; min-height: 240px; resize: vertical;
    padding: 12px 14px; border: 0; background: transparent;
    font: 400 0.85rem/1.55 var(--mono); color: var(--chalk); caret-color: var(--y);
  }
  .editor textarea:focus-visible { outline: none; }
  .lado { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .checks li { display: flex; gap: 10px; align-items: baseline; font-size: 0.95rem; line-height: 1.45; color: var(--chalk-70); }
  .checks li :global(code) { font: 400 0.9em var(--mono); color: var(--chalk); }
  .marca { flex: none; width: 16px; height: 16px; translate: 0 3px; border: 2px solid var(--chalk-45); border-radius: 48% 52% 45% 55% / 55% 45% 52% 48%; transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out); }
  .checks li[data-estado='ok'] { color: var(--chalk); }
  .checks li[data-estado='ok'] .marca { background: var(--ok); border-color: var(--ok); }
  .checks li[data-estado='mal'] .marca { border-color: var(--red); }
  .salida { padding: 10px 14px 12px; border-top: 2px dashed var(--chalk-08); background: rgba(0, 0, 0, 0.18); }
  .salida .cv-prompt { margin: 0; font: 400 0.8rem var(--mono); }
  .salida output { display: block; margin-top: 4px; min-height: 3.2em; font: 400 0.8rem/1.55 var(--mono); color: var(--chalk); white-space: pre-wrap; overflow-wrap: anywhere; max-height: 9.5em; overflow-y: auto; }
  .salida output.error { color: var(--red); }
  .botones { display: flex; flex-wrap: wrap; gap: 8px; }
  .botones small { font: 400 0.8rem var(--read); color: var(--azul); }
  .pistas { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; color: var(--chalk-70); font-size: 0.95rem; line-height: 1.5; }
  .pistas:empty { display: none; }
  .pistas :global(li::marker) { color: var(--azul); font-weight: 700; }
  .pistas :global(code) { font-family: var(--mono); color: var(--chalk); }
  .solucion { grid-column: 1 / -1; display: grid; gap: 10px; }
  .solucion pre { margin: 0; padding: 10px 0; font: 400 0.82rem/1.5rem var(--mono); background: rgba(0, 0, 0, 0.14); overflow-x: auto; }
  .solucion code { display: block; min-width: max-content; }
  .solucion .l { display: block; white-space: pre; padding-right: 12px; }
  .solucion .l i { display: inline-block; width: 34px; padding-right: 12px; text-align: right; font-style: normal; color: var(--azul); opacity: 0.75; }
  .explica { max-width: var(--measure); color: var(--chalk-70); }
  .explica :global(p) { margin: 0 0 0.6em; }
  .explica :global(code) { font-family: var(--mono); color: var(--chalk); }
  @media (max-width: 820px) { .lab { grid-template-columns: 1fr; } }
</style>
