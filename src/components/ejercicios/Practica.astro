---
// Pizarrón de práctica: agrupa los ejercicios de la lección y los presenta como retos, uno a la vez.
import Icono from '../Icono.astro';
---
<section class="practica" id="practica" aria-labelledby="practica-titulo" data-practica>
  <header class="cab">
    <svg class="tiza-ico" viewBox="0 0 48 48" aria-hidden="true">
      <g transform="rotate(-28 24 24)">
        <rect x="8" y="19" width="30" height="10" rx="3" fill="#f7df1e" />
        <rect x="8" y="19" width="9" height="10" rx="3" fill="#eceae2" opacity=".85" />
        <path d="M38 20.5c2.5 1 3.5 2.4 3.5 3.5s-1 2.5-3.5 3.5" fill="#f7df1e" />
      </g>
      <path d="M6 41c6-2 12-2.4 18-1.4" stroke="#f7df1e" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".7" />
    </svg>
    <div class="titulos">
      <h2 id="practica-titulo">¡A practicar!</h2>
      <p class="sub">Tu progreso se guarda en este navegador.</p>
    </div>
    <p class="cuenta" data-cuenta aria-live="polite"></p>
  </header>

  <div class="pasos" role="tablist" aria-label="Retos de la lección" data-pasos></div>

  <div class="retos" data-retos>
    <slot />
  </div>

  <nav class="mover" aria-label="Cambiar de reto" data-mover hidden>
    <p class="aviso" data-aviso aria-live="polite"></p>
    <div class="botones">
      <button type="button" class="btn" data-reto-anterior><Icono nombre="izq" />Anterior</button>
      <button type="button" class="btn btn--y" data-reto-siguiente>Siguiente reto<Icono nombre="der" /></button>
    </div>
  </nav>

  <div class="bandeja" aria-hidden="true"><i class="c1"></i><i class="c2"></i><i class="c3"></i><i class="c4"></i></div>
</section>

<script>
  import { resumen } from '../../scripts/progreso';
  import { conTransicion } from '../../scripts/transiciones';

  const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.6 12.8c1.8 1.6 3.4 3.3 5 5.2 3-4.7 6.3-9 10-12.8"/></svg>';
  const suave = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');

  document.querySelectorAll<HTMLElement>('[data-practica]').forEach((el) => {
    const retos = Array.from(el.querySelectorAll<HTMLElement>('[data-retos] [data-ejercicio-id]'));
    if (!retos.length) return;
    const pasos = el.querySelector<HTMLElement>('[data-pasos]')!;
    const cuenta = el.querySelector<HTMLElement>('[data-cuenta]')!;
    const mover = el.querySelector<HTMLElement>('[data-mover]')!;
    const anterior = el.querySelector<HTMLButtonElement>('[data-reto-anterior]')!;
    const siguiente = el.querySelector<HTMLButtonElement>('[data-reto-siguiente]')!;
    const aviso = el.querySelector<HTMLElement>('[data-aviso]')!;
    let activo = 0;

    const resuelto = (k: number) => !!resumen().ejercicios[retos[k].dataset.ejercicioId!];
    // Hasta dónde se puede llegar: el primer reto sin resolver
    const alcanzado = () => {
      const k = retos.findIndex((_, i) => !resuelto(i));
      return k < 0 ? retos.length - 1 : k;
    };

    const botones = retos.map((r, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `paso f-${r.dataset.color}`;
      b.id = `${r.id}-tab`;
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-controls', r.id);
      b.innerHTML = `<span class="n">${i + 1}</span><span class="v">${CHECK}</span><span class="sr-only">: ${r.dataset.formato}, ${r.dataset.titulo}</span>`;
      b.title = `${r.dataset.formato}: ${r.dataset.titulo}`;
      b.addEventListener('click', () => conTransicion(() => activar(i, true)));
      r.setAttribute('role', 'tabpanel');
      r.setAttribute('aria-labelledby', b.id);
      pasos.append(b);
      return b;
    });

    function subir() {
      // En la columna lateral, el pizarrón tiene su propio scroll; si no, se lleva a la vista
      if (el.closest('[data-lado-practica]')) el.scrollTo({ top: 0, behavior: suave() });
      else el.scrollIntoView({ block: 'start', behavior: suave() });
    }

    function activar(i: number, foco = false) {
      if (i < 0 || i >= retos.length || i > alcanzado()) return;
      activo = i;
      retos.forEach((r, k) => (r.hidden = k !== activo));
      botones.forEach((b, k) => {
        b.setAttribute('aria-selected', String(k === activo));
        b.tabIndex = k === activo ? 0 : -1;
      });
      pintar();
      if (foco) botones[activo].focus();
    }

    function pintar() {
      let n = 0;
      const tope = alcanzado();
      retos.forEach((_, k) => {
        const ok = resuelto(k);
        botones[k].classList.toggle('hecho', ok);
        const bloqueado = k > tope;
        botones[k].disabled = bloqueado;
        botones[k].classList.toggle('bloqueado', bloqueado);
        if (ok) n++;
      });
      cuenta.textContent = `${n}/${retos.length} resueltos`;
      cuenta.classList.toggle('completo', n === retos.length);

      const ultimo = activo === retos.length - 1;
      const listo = resuelto(activo);
      anterior.hidden = activo === 0;
      siguiente.hidden = ultimo;
      siguiente.disabled = !listo;
      if (n === retos.length && ultimo) aviso.textContent = '¡Completaste todos los retos de esta lección!';
      else if (!listo) aviso.textContent = ultimo ? 'Resuelve este reto para completar la lección.' : 'Resuelve este reto para pasar al siguiente.';
      else if (!ultimo) aviso.textContent = '¡Bien! Ya puedes pasar al siguiente reto.';
      else aviso.textContent = '';
      aviso.classList.toggle('listo', listo);
    }

    pasos.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); activar(activo + 1, true); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); activar(activo - 1, true); }
    });
    anterior.addEventListener('click', () => conTransicion(() => { activar(activo - 1); subir(); }));
    siguiente.addEventListener('click', () => conTransicion(() => { activar(activo + 1); subir(); }));

    const desdeHash = retos.findIndex((r) => `#${r.id}` === location.hash);
    activar(desdeHash >= 0 && desdeHash <= alcanzado() ? desdeHash : alcanzado());
    mover.hidden = false;
    // Con un solo reto, los pasos numerados no aportan nada
    pasos.hidden = retos.length < 2;
    document.addEventListener('domina:progreso', pintar);
  });
</script>

<style>
  .practica {
    view-transition-name: practica;
    container-type: inline-size;
    position: relative;
    margin: 3em 0 2em;
    padding: 26px 30px 54px;
    background:
      radial-gradient(ellipse 420px 140px at 80% 0%, var(--chalk-04), transparent 70%),
      repeating-linear-gradient(97deg, rgba(236, 234, 226, 0.012) 0 2px, transparent 2px 7px),
      var(--board-lo);
    border: 10px solid var(--edge);
    border-radius: 12px;
    box-shadow: inset 0 0 0 2px rgba(236, 234, 226, 0.06), inset 0 0 60px rgba(0, 0, 0, 0.45), 0 10px 26px rgba(0, 0, 0, 0.35);
    scroll-margin-top: 16px;
  }
  .cab { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .tiza-ico { width: 48px; height: 48px; flex: none; filter: url(#tiza); }
  .titulos { flex: 1; min-width: 0; }
  h2 { margin: 0; font: 700 clamp(1.7rem, 2.6vw, 2.2rem) / 1 var(--hand); color: var(--chalk); }
  .sub { margin: 4px 0 0; font-size: 0.88rem; color: var(--chalk-70); }
  .cuenta {
    margin: 0; flex: none;
    font: 600 0.85rem/1 var(--mono);
    color: var(--chalk);
    padding: 8px 14px;
    border: 2px solid var(--chalk-15);
    border-radius: 999px;
  }
  .cuenta.completo { color: var(--board-lo); background: var(--ok); border-color: var(--ok); }

  .pasos { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: 26px; }
  .pasos :global(.paso) {
    --c: var(--chalk-70);
    position: relative;
    display: grid; place-items: center;
    width: 44px; height: 44px;
    margin-right: 30px;
    padding: 0;
    font: 700 1.25rem/1 var(--hand);
    color: var(--c);
    background: var(--board-lo);
    border: 2.5px solid var(--c);
    border-radius: 48% 52% 45% 55% / 55% 45% 52% 48%;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out), transform 180ms var(--ease-out);
  }
  .pasos :global(.paso:last-child) { margin-right: 0; }
  /* raya de tiza entre retos */
  .pasos :global(.paso:not(:last-child))::after {
    content: '';
    position: absolute; left: calc(100% + 4px); top: 50%;
    width: 22px; height: 2px;
    background: repeating-linear-gradient(90deg, var(--chalk-45) 0 5px, transparent 5px 8px);
  }
  .pasos :global(.paso:hover) { transform: rotate(-4deg) scale(1.05); }
  .pasos :global(.paso[aria-selected='true']) { color: var(--board-lo); background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent); }
  .pasos :global(.paso .v) { display: none; }
  .pasos :global(.paso.hecho .n) { display: none; }
  .pasos :global(.paso.hecho .v) { display: grid; place-items: center; }
  .pasos :global(.paso .v svg) { width: 20px; height: 20px; }
  .pasos :global(.f-naranja) { --c: var(--naranja); }
  .pasos :global(.f-azul) { --c: var(--azul); }
  .pasos :global(.f-rosa) { --c: var(--pink); }
  .pasos :global(.f-lila) { --c: var(--lila); }
  .pasos :global(.f-lima) { --c: var(--lima); }

  .mover { margin-top: 22px; padding-top: 16px; border-top: 2px dashed var(--chalk-08); }
  .aviso { margin: 0 0 12px; font-size: 0.92rem; font-weight: 700; color: var(--chalk-70); }
  .aviso.listo { color: var(--ok); }
  .aviso:empty { display: none; }
  .botones { display: flex; gap: 10px; }
  .botones [data-reto-siguiente] { margin-left: auto; }
  .pasos :global(.paso.bloqueado) { opacity: 0.4; cursor: not-allowed; transform: none; }

  .bandeja { pointer-events: none; position: absolute; left: 0; right: 0; bottom: 0; height: 18px; background: var(--tray); border-top: 2px solid rgba(236, 234, 226, 0.06); border-radius: 0 0 2px 2px; }
  .bandeja i { position: absolute; bottom: 5px; height: 8px; border-radius: 3px; }
  .bandeja .c1 { left: 8%; width: 40px; background: var(--y); }
  .bandeja .c2 { left: 14%; width: 26px; background: var(--pink); }
  .bandeja .c3 { left: 19%; width: 32px; background: var(--azul); }
  .bandeja .c4 { right: 10%; width: 22px; background: var(--lila); }

  /* En la columna lateral el pizarrón es más angosto */
  :global(.practica-al-lado) .practica { padding: 20px 18px 46px; border-width: 8px; }
  :global(.practica-al-lado) .cab { gap: 10px; margin-bottom: 18px; }
  :global(.practica-al-lado) h2 { font-size: 1.6rem; white-space: nowrap; }
  :global(.practica-al-lado) .sub { display: none; }
  :global(.practica-al-lado) .tiza-ico { width: 38px; height: 38px; }
  :global(.practica-al-lado) .cuenta { font-size: 0.78rem; padding: 6px 10px; }
  @media (max-width: 720px) {
    .practica { padding: 20px 14px 46px; border-width: 6px; margin-inline: -8px; }
    .cab { flex-wrap: wrap; }
    .pasos :global(.paso) { width: 40px; height: 40px; margin-right: 22px; }
    .pasos :global(.paso:not(:last-child))::after { width: 14px; }
  }
</style>
