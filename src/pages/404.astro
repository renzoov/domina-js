---
// Página para las direcciones que no existen. Cloudflare Pages la sirve sola (404.html) con el código 404.
import BaseLayout from '../layouts/BaseLayout.astro';
import Subrayado from '../components/Subrayado.astro';
import Icono from '../components/Icono.astro';
import BotonRayosX from '../components/BotonRayosX.astro';
import { REPORTAR } from '../data/sitio';
---
<BaseLayout noindex titulo="Página no encontrada · domina-js" descripcion="Esta página no existe. Vuelve al inicio o busca el tema en el temario.">
  <div class="nf">
    <p class="num" aria-hidden="true">404</p>
    <h1>Esta página se borró del pizarrón</h1>
    <Subrayado ancho={420} />
    <p class="lead">O nunca estuvo escrita. Puede que la dirección tenga un error, o que el tema haya cambiado de lugar.</p>

    <div class="consola caja" aria-label="Lo que diría la consola">
      <span class="rotulo">Consola</span>
      <pre><code><span class="t-kw">const</span> pagina = sitio.<span class="t-fn">buscar</span>(<span class="t-str" data-ruta>"/esta-pagina"</span>);
pagina.<span class="t-fn">mostrar</span>();
<span class="err">Uncaught TypeError: Cannot read properties of undefined (reading 'mostrar')</span></code></pre>
    </div>

    <div class="acciones">
      <a class="btn btn--y" href="/">Volver al inicio<Icono nombre="der" /></a>
      <a class="btn" href="/temario">Buscar en el temario</a>
      <BotonRayosX variante="nav" />
    </div>
    <p class="nota">¿Llegaste aquí desde un enlace del sitio? Es un error nuestro: <a href={REPORTAR} target="_blank" rel="noopener noreferrer">avísame en GitHub<span class="sr-only"> (se abre en otra pestaña)</span></a>.</p>
  </div>
</BaseLayout>

<script>
  // Muestra la dirección que se buscó, en el «código» del error
  const ruta = document.querySelector('[data-ruta]');
  if (ruta) ruta.textContent = JSON.stringify(decodeURI(location.pathname));
</script>

<style>
  .nf { max-width: 760px; }
  .num { margin: 0; font: 700 clamp(5rem, 12vw, 8rem) / 0.9 var(--hand); color: var(--y); text-shadow: 0 0 14px rgba(247, 223, 30, 0.3); transform: rotate(-3deg); width: fit-content; }
  h1 { margin: 14px 0 0; font: 700 clamp(2.2rem, 4.4vw, 3.6rem) / 1.05 var(--hand); text-shadow: 0 0 3px rgba(236, 234, 226, 0.4); }
  .lead { margin: 18px 0 26px; max-width: 56ch; font-size: 1.12rem; line-height: 1.6; color: var(--chalk-70); }
  .consola { padding: 14px 18px; background: var(--pozo); }
  .consola .rotulo { display: block; margin-bottom: 8px; }
  .consola pre { margin: 0; font: 400 0.92rem/1.7 var(--mono); white-space: pre-wrap; word-break: break-word; }
  .err { color: var(--red); }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; margin-top: 28px; }
  .acciones .btn { padding: 12px 18px; }
  .nota { margin: 26px 0 0; font-size: 0.92rem; color: var(--chalk-70); }
  .nota a { color: var(--chalk); font-weight: 700; text-decoration-color: var(--y); }
</style>
